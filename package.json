{
  "name": "storybook-css-modules",
  "version": "2.0.0",
  "description": "Storybook preset to add CSS Modules support to webpack based Storybook frameworks",
  "author": {
    "name": "Arthelokyo",
    "email": "hello@arthelokyo.com",
    "url": "https://github.com/arthelokyo"
  },
  "license": "MIT",
  "keywords": [
    "storybook-addon",
    "storybook-addons",
    "style",
    "code",
    "css-modules",
    "css",
    "preset",
    "storybook",
    "addon",
    "cssmodules",
    "modules"
  ],
  "homepage": "https://storybook.js.org/addons/storybook-css-modules",
  "bugs": {
    "url": "https://github.com/arthelokyo/storybook-css-modules/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arthelokyo/storybook-css-modules.git"
  },
  "type": "module",
  "main": "./dist/preset.cjs",
  "exports": {
    ".": {
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    },
    "./preset": {
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/preset.js --format esm,cjs --platform node --target node18 --clean",
    "watch": "npm run build -- --watch",
    "clean": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build",
    "test:compat": "node scripts/compat-test.mjs",
    "storybook": "npm --prefix examples/react run storybook",
    "build-storybook": "npm --prefix examples/react run build-storybook"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "storybook": ">=6.5.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "storybook": {
    "displayName": "Storybook CSS Modules",
    "unsupportedFrameworks": [],
    "supportedFrameworks": [
      "react",
      "preact",
      "vue"
    ],
    "icon": "https://raw.githubusercontent.com/arthelokyo/storybook-css-modules/main/logo-css-modules.png"
  }
}
